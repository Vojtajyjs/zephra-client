{
  "name": "zephra-launcher",
  "version": "0.1.6",
  "description": "Zephra Client launcher",
  "author": "Zephra",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "dependencies": { "minecraft-launcher-core": "^3.18.2", "msmc": "^5.0.5" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0" },
  "build": {
    "appId": "dev.zephra.launcher",
    "productName": "Zephra",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "extraResources": [{ "from": "resources", "to": "resources" }],
    "directories": { "buildResources": "build" },
    "mac": { "category": "public.app-category.games", "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }] },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
